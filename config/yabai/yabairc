# 桌面／螢幕改變時通知 SketchyBar 更新；只影響顯示，不負責切換。
if command -v sketchybar >/dev/null 2>&1; then
	for event in space_changed display_changed; do
		yabai -m signal --remove "migration-$event" 2>/dev/null || true
		yabai -m signal --add label="migration-$event" event="$event" action="/opt/homebrew/bin/sketchybar --trigger yabai_space_change"
	done
	sketchybar --trigger yabai_space_change
fi
