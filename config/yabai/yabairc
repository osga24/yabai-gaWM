# yabai -m rule --add 'app=^QuickTime\ Player$' manage=off
# yabai -m rule --add label=aerospace-migrated-0 'app=^Finder$' manage=off
yabai -m rule --add label=aerospace-migrated-1 'app=^System\ Settings$' manage=off
