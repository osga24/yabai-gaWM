#!/bin/sh
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# 從 AeroSpace 遷移；保持 SIP 開啟，未載入 scripting addition。
# 預設用 BSP 二分割平鋪；不是 AeroSpace 的容器樹。
yabai -m config layout bsp
# 依區域長寬比自動選擇左右／上下分割。
yabai -m config split_type auto
# 新分割初始比例為一半。
yabai -m config split_ratio 0.5
# 視窗數量變動時平均面積，可能重設手動比例。
yabai -m config auto_balance on
# 鍵盤切換焦點時，游標跟隨視窗。
yabai -m config mouse_follows_focus on
# 滑鼠移過視窗時不自動搶焦點。
yabai -m config focus_follows_mouse off
# 新視窗預設放在分割的右側或下側。
yabai -m config window_placement second_child
# 按住 Option 配合滑鼠操作。
yabai -m config mouse_modifier alt
# Option＋左鍵拖曳：移動／重新排列。
yabai -m config mouse_action1 move
# Option＋右鍵拖曳：調整大小。
yabai -m config mouse_action2 resize
# 拖到鄰居中央時交換；邊緣則重新插入。
yabai -m config mouse_drop_action swap
# 嘗試跳過跨桌面聚焦動畫；數字切桌面另由 tools/SpaceSwitch.app 負責。
yabai -m config skip_window_focus_animation on
# 螢幕四邊留白各 6 點。
yabai -m config top_padding 6
yabai -m config bottom_padding 6
yabai -m config left_padding 6
yabai -m config right_padding 6
# 平鋪視窗之間留 6 點。
yabai -m config window_gap 6
# App 例外：manage=off 保持浮動；manage=on 納入平鋪。
# yabai -m rule --add 'app=^Calculator$' manage=off
